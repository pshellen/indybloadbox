{
  "name": "FSCinema Menu Board",
  "permissions": {
    "network": "Fetches the configured menu manifest and its public image/video assets."
  },
  "options": [
    {
      "title": "Manifest endpoint",
      "name": "endpoint",
      "type": "string",
      "default": "https://emcxmnrhplzlbsowxeuk.supabase.co/functions/v1/menu-board-manifest"
    },
    {
      "title": "Location",
      "name": "location",
      "type": "select",
      "options": [
        ["2dc32f05-a243-4679-b933-be77c8a6f7c8", "Auburn"],
        ["bdb4f395-6ba8-40f1-b301-f25abb6325c2", "Cambridge"],
